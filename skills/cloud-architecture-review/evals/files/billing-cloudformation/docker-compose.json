{
  "services": {
    "api": {
      "build": ".",
      "ports": ["8080:8080"],
      "environment": {
        "DATABASE_HOST": "db",
        "JWT_SECRET": "example-only-jwt-secret",
        "PAYMENT_API_KEY": "${PAYMENT_API_KEY}"
      },
      "depends_on": ["db"]
    },
    "db": {
      "image": "mysql:8.4",
      "environment": [
        "MYSQL_DATABASE=billing",
        "MYSQL_ROOT_PASSWORD=example-only-root-password"
      ]
    }
  }
}
