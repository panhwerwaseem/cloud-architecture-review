[
  {
    "apiVersion": "apps/v1",
    "kind": "Deployment",
    "metadata": {"name": "tracker-api", "namespace": "tracker"},
    "spec": {
      "replicas": 1,
      "selector": {"matchLabels": {"app": "tracker-api"}},
      "template": {
        "metadata": {"labels": {"app": "tracker-api"}},
        "spec": {
          "serviceAccountName": "tracker-api",
          "containers": [
            {
              "name": "api",
              "image": "europe-west1-docker.pkg.dev/example/tracker/api:1.8.2",
              "ports": [{"containerPort": 8080}],
              "env": [
                {"name": "LOG_LEVEL", "value": "info"},
                {"name": "DATABASE_PASSWORD", "value": "example-only-not-a-real-password"},
                {
                  "name": "SESSION_SECRET",
                  "valueFrom": {"secretKeyRef": {"name": "tracker-secrets", "key": "session-secret"}}
                }
              ]
            }
          ]
        }
      }
    }
  },
  {
    "apiVersion": "v1",
    "kind": "Service",
    "metadata": {"name": "tracker-api", "namespace": "tracker"},
    "spec": {
      "type": "LoadBalancer",
      "selector": {"app": "tracker-api"},
      "ports": [{"port": 443, "targetPort": 8080}]
    }
  },
  {
    "apiVersion": "v1",
    "kind": "Secret",
    "metadata": {"name": "tracker-secrets", "namespace": "tracker"},
    "type": "Opaque",
    "data": {"session-secret": "ZXhhbXBsZS1vbmx5"}
  }
]
