{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Clean fixture: this template must produce no finding.",
  "Parameters": {
    "VpcId": {"Type": "AWS::EC2::VPC::Id"},
    "DbPasswordSecretName": {"Type": "String", "Default": "billing/db"}
  },
  "Resources": {
    "Database": {
      "Type": "AWS::RDS::DBInstance",
      "Properties": {
        "Engine": "mysql",
        "DBInstanceClass": "db.m6g.large",
        "AllocatedStorage": "50",
        "MasterUsername": "billing",
        "MasterUserPassword": "{{resolve:secretsmanager:billing/db:SecretString:password}}",
        "MultiAZ": true,
        "StorageEncrypted": true,
        "DeletionProtection": true,
        "PubliclyAccessible": false,
        "BackupRetentionPeriod": 14
      }
    },
    "WebSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Billing web",
        "VpcId": {"Ref": "VpcId"},
        "SecurityGroupIngress": [
          {"IpProtocol": "tcp", "FromPort": 443, "ToPort": 443, "CidrIp": "0.0.0.0/0"}
        ]
      }
    },
    "InvoiceBucket": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        }
      }
    },
    "InvoiceTable": {
      "Type": "AWS::DynamoDB::Table",
      "Properties": {
        "BillingMode": "PAY_PER_REQUEST",
        "DeletionProtectionEnabled": true,
        "PointInTimeRecoverySpecification": {"PointInTimeRecoveryEnabled": true},
        "AttributeDefinitions": [{"AttributeName": "invoice_id", "AttributeType": "S"}],
        "KeySchema": [{"AttributeName": "invoice_id", "KeyType": "HASH"}]
      }
    },
    "ExportLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/aws/lambda/billing-export",
        "RetentionInDays": 30
      }
    },
    "DbCpuAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "Namespace": "AWS/RDS",
        "MetricName": "CPUUtilization",
        "ComparisonOperator": "GreaterThanThreshold",
        "Threshold": 80,
        "EvaluationPeriods": 3,
        "Period": 300,
        "Statistic": "Average"
      }
    }
  }
}
